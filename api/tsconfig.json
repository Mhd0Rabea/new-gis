{
    "compilerOptions":  {
                            "module":  "commonjs",
                            "declaration":  true,
                            "removeComments":  true,
                            "emitDecoratorMetadata":  true,
                            "experimentalDecorators":  true,
                            "allowSyntheticDefaultImports":  true,
                            "target":  "ES2022",
                            "sourceMap":  true,
                            "rootDir":  ".",
                            "outDir":  "./dist",
                            "incremental":  true,
                            "strict":  true,
                            "skipLibCheck":  true,
                            "esModuleInterop":  true,
                            "types":  [
                                          "node",
                                          "jest"
                                      ]
                        },
    "include":  [
                    "src/**/*.ts",
                    "test/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "dist"
                ]
}
