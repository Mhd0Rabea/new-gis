# Copy to .env locally. Never commit real credentials.
DATABASE_URL=postgresql://mgos:<password>@localhost:5432/mgos
DATABASE_SCHEMA=mgos
DATABASE_SSL=false
API_HOST=127.0.0.1
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173

# Optional isolated database for live integration tests.
TEST_DATABASE_URL=postgresql://mgos:<password>@localhost:5432/mgos_test

# Advanced spatial processing
PROCESSING_TOOLS_BIN=C:/Program Files/QGIS 3.44.13/bin
PROCESSING_SAMPLES_DIR=../gis/samples/processing
PROCESSING_WORK_DIR=../.processing-work

PROCESSING_CONCURRENCY=1

PROCESSING_TOOLS_BIN=
PROCESSING_INPUT_DIR=
PROCESSING_WORK_DIR=
PROCESSING_CLEANUP_HOURS=24
